      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{compose_project=\"laravelbd\", container=~\"$container\"} |~ \"(?i)(${level:pipe})|^[^{]\"",
          "refId": "A"
        }
      ],
      "title": "Logs",
      "type": "logs"
    }
